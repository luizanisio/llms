# ==========================================================================
# Variáveis de ambiente para o pacote de extração (util_vllm_batch.py)
# ==========================================================================
# O arquivo .env é carregado automaticamente pelo script via UtilEnv.carregar_env()
# buscando em: ./ , ../ , ../src/
#
# Para modelos com prefixo oa: (OpenAIA), a classe UtilOA espera:
#   OA_KEY = url::usuario::senha   (separador :: entre os campos)
#
# Opcionalmente, OA_CONTROLE permite enviar parâmetros extras no payload:
#   OA_CONTROLE = '{"chave": "valor"}'
# ==========================================================================

# --- Credenciais OpenAIA (oa:) ---
# Formato: URL_DA_API::USUARIO::SENHA
# Exemplo: https://minha-api.exemplo.com/v1/chat::meu_usuario::minha_senha
OA_KEY=https://sua-url-api/endpoint::seu_usuario::sua_senha

# --- Controle extra OpenAIA (opcional) ---
# JSON com parâmetros extras para o payload da requisição
# OA_CONTROLE={"chave": "valor"}

# --- Chaves para outras APIs (caso necessário) ---
# PESSOAL_OPENAI_API_KEY=sk-...
# PESSOAL_OPENROUTER_API_KEY=sk-or-...
# PESSOAL_TOGETHER_API_KEY=...
# PESSOAL_MARITACA_API_KEY=...
# VLLM_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
